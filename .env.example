# Sarvam AI API Key (obtain from https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# CARTO Basemaps API Key (obtain free key from https://carto.com/basemaps/apikey)
CARTO_API_KEY=your_carto_basemaps_api_key_here
VITE_CARTO_KEY=your_carto_basemaps_api_key_here
